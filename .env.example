# Copy this file to .env and fill in what you have.

# SAM.gov public API key (free). Create one under "Account Details" on sam.gov.
# Required for contracts, small-business set-asides, and sources-sought notices.
SAM_API_KEY=

# At least one AI provider key is required for scoring and deep search.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# Optional tuning
# SAM_LOOKBACK_DAYS=30          # how far back each run looks for new notices
# SAM_MAX_PAGES=2               # pages of up to 1,000 notices per run
# SAM_MAX_DESCRIPTIONS=0        # full-text fetches per run; each is one API call.
#                               # Raise this only if your SAM.gov key has a high daily limit.
# CRADA_LOOKBACK_DAYS=365
# MAX_WEB_SEARCHES=15
# MAX_PAGE_FETCHES=12
# GEMINI_MAX_SEARCHES=15
# DEEP_SEARCH_TIMEOUT=900        # seconds before a stalled deep search is abandoned
